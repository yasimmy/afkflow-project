{
  "name": "afkflow-backend",
  "version": "1.0.0",
  "description": "AFKFlow Backend API — Node.js + Fastify + TypeScript + SQLite",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "db:migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/session": "^10.9.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16.4.4",
    "fastify": "^4.26.0",
    "nanoid": "^5.0.6",
    "pino-pretty": "^13.1.3",
    "sql.js": "^1.14.2",
    "undici": "^6.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
