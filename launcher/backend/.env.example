# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# ─── Session ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_BEFORE_PRODUCTION
ADMIN_PASSWORD=CHANGE_ME_BEFORE_PRODUCTION

# ─── Discord OAuth2 ───────────────────────────────────────────────────────────
# NEVER expose these in frontend code or git
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=./data/afkflow.db

# ─── App ──────────────────────────────────────────────────────────────────────
APP_VERSION=1.0.0
APP_MIN_VERSION=1.0.0
FRONTEND_URL=http://localhost:5173

# ─── Payments ────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
PAYMENT_WEBHOOK_SECRET=change_me

# Russia
TBANK_TERMINAL_KEY=
TBANK_SECRET_KEY=
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
PAYSELECTION_PUBLIC_KEY=
PAYSELECTION_SECRET_KEY=
# Europe / international
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
REVOLUT_SECRET_KEY=
# Ukraine
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=
FONDY_MERCHANT_ID=
FONDY_SECRET_KEY=
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
PLATA_MERCHANT_ID=
PLATA_SECRET_KEY=
