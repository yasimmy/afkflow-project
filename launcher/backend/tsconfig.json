{
  "compilerOptions": {
    "target":        "ES2022",
    "module":        "ESNext",
    "moduleResolution": "bundler",
    "lib":           ["ES2022"],
    "outDir":        "./dist",
    "rootDir":       "./src",
    "strict":        true,
    "esModuleInterop": true,
    "skipLibCheck":  true,
    "resolveJsonModule": true,
    "declaration":   false,
    "noUnusedLocals": true,
    "noImplicitReturns": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
